      "targets": [
        {
          "datasource": {
            "type": "prometheus",
            "uid": "${prometheus}"
          },
          "expr": "count by (reason) (crossplane_state_resource_condition{xp_group=~\"$group\", xp_composite=~\"$composite\", condition=\"Synced\", status!=\"True\"})",
          "format": "table",
          "instant": true,
          "refId": "A"
        }
      ],
      "title": "Not Synced Reasons",
      "transformations": [
        {
          "id": "organize",
