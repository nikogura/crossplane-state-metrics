          },
          "expr": "count by (status) (crossplane_state_resource_condition{xp_group=~\"$group\", xp_composite=~\"$composite\", condition=\"Ready\"})",
          "legendFormat": "{{status}}",
          "refId": "A"
        }
      ],
      "title": "Ready Status Over Time",
      "type": "timeseries",
      "description": "Ready is the provider's verdict on the resource itself. A resource can be Synced and not Ready while it is still being created."
    },
    {
      "type": "row",
      "title": "Drift",
      "id": 15,
      "collapsed": false,
      "gridPos": {
        "h": 1,
        "w": 24,
        "x": 0,
        "y": 14
      },
      "panels": [],
      "description": "Resources whose observed state no longer matches what was declared. Conditions say whether Crossplane could reconcile; drift says whether the result still holds."
    },
    {
      "type": "stat",
      "title": "Drifted Managed Resources",
      "id": 16,
      "datasource": {
        "type": "prometheus",
        "uid": "${prometheus}"
      },
      "description": "Managed resources whose spec.forProvider no longer matches the observed status.atProvider. A resource can be Synced and Ready and still have drifted: Crossplane reports the reconcile it last performed, not whether the cloud has moved since.",
      "gridPos": {
        "h": 8,
        "w": 6,
        "x": 0,
        "y": 15
      },
      "targets": [
        {
          "datasource": {
            "type": "prometheus",
            "uid": "${prometheus}"
          },
          "refId": "A",
          "instant": true,
          "range": false,
          "expr": "sum(crossplane_state_mr_drift{xp_group=~\"$group\", xp_composite=~\"$composite\"}) or vector(0)"
        }
      ],
      "options": {
        "reduceOptions": {
          "calcs": [
            "lastNotNull"
          ],
          "fields": "",
          "values": false
        },
        "orientation": "auto",
        "textMode": "auto",
        "colorMode": "value",
        "graphMode": "area",
        "justifyMode": "auto"
      },
      "fieldConfig": {
        "defaults": {
          "unit": "short",
          "color": {
            "mode": "thresholds"
          },
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "green",
                "value": null
              },
              {
                "color": "orange",
                "value": 1
              }
            ]
          }
        },
        "overrides": []
      }
    },
    {
      "type": "table",
      "title": "Drifted Resources",
      "id": 17,
      "datasource": {
        "type": "prometheus",
        "uid": "${prometheus}"
      },
      "description": "Which resources drifted. Enable --drift-fields on the exporter to also see which fields differ. Only managed resources appear here: they are the only kinds carrying both a declared and an observed state.",
      "gridPos": {
        "h": 8,
        "w": 18,
        "x": 6,
        "y": 15
      },
      "targets": [
        {
          "datasource": {
            "type": "prometheus",
            "uid": "${prometheus}"
          },
          "refId": "A",
          "instant": true,
          "range": false,
          "expr": "crossplane_state_mr_drift{xp_group=~\"$group\", xp_composite=~\"$composite\"} > 0"
        }
      ],
      "transformations": [
        {
          "id": "organize",
          "options": {
            "excludeByName": {
              "Time": true,
              "Value": true,
              "__name__": true,
              "job": true,
              "instance": true,
              "endpoint": true,
              "container": true,
              "namespace": true,
              "pod": true,
              "service": true,
              "prometheus": true,
              "xp_claim_namespace": true
            },
            "renameByName": {
              "xp_kind": "Kind",
              "xp_name": "Name",
              "xp_namespace": "Namespace",
              "xp_group": "Group",
              "xp_version": "Version",
              "xp_composite": "Composite",
              "xp_claim": "Claim"
            },
            "indexByName": {}
          }
        }
      ],
      "options": {
        "showHeader": true,
        "footer": {
          "show": false
        }
      },
      "fieldConfig": {
        "defaults": {
          "custom": {
            "align": "auto",
            "filterable": true
          }
        },
        "overrides": []
      }
    },
